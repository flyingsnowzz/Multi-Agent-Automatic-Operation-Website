# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here

# DeepSeek API Configuration
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Article scoring LLM Configuration
# For DeepSeek:
# ARTICLE_SCORING_API_KEY=your_deepseek_api_key_here
# ARTICLE_SCORING_MODEL=deepseek-v4-flash
# ARTICLE_SCORING_BASE_URL=https://api.deepseek.com
ARTICLE_SCORING_API_KEY=
ARTICLE_SCORING_MODEL=deepseek-v4-flash
ARTICLE_SCORING_BASE_URL=https://api.openai.com/v1
# Scoring provider protection. If the model/provider is briefly rate-limited,
# retry the same article before treating it as missing. If a whole batch has too
# many missing scores, the runner pauses instead of immediately hammering the
# next batch.
ARTICLE_SCORING_MAX_RETRIES=2
ARTICLE_SCORING_RETRY_SLEEP_SECONDS=5
ARTICLE_SCORING_MISSING_BATCH_RATIO=0.5
ARTICLE_SCORING_MISSING_BATCH_MIN_COUNT=3
# Keep false in production so freshness penalties reduce the absolute total
# score. Set true only for experiments that intentionally stretch each batch
# into the 75-100 range.
ARTICLE_SCORING_STRETCH_SCORES=false
# Freshness policy for content_importance_score.
# content_importance_score = raw_content_importance_score * freshness_factor.
# Set ARTICLE_SCORING_FRESHNESS_IMPORTANCE_WEIGHT_ENABLED=false to keep raw
# importance untouched while still calculating freshness_score for logs.
ARTICLE_SCORING_FRESHNESS_IMPORTANCE_WEIGHT_ENABLED=true
ARTICLE_SCORING_FRESHNESS_RECENT_MONTHS=2
ARTICLE_SCORING_FRESHNESS_MID_MONTHS=6
ARTICLE_SCORING_FRESHNESS_OLD_MONTHS=12
ARTICLE_SCORING_FRESHNESS_VERY_OLD_MONTHS=24
ARTICLE_SCORING_FRESHNESS_STALE_MONTHS=36
ARTICLE_SCORING_FRESHNESS_FACTOR_UNKNOWN=0.5
ARTICLE_SCORING_FRESHNESS_FACTOR_RECENT=1.0
ARTICLE_SCORING_FRESHNESS_FACTOR_MID=0.8
ARTICLE_SCORING_FRESHNESS_FACTOR_OLD=0.5
ARTICLE_SCORING_FRESHNESS_FACTOR_VERY_OLD=0.5
ARTICLE_SCORING_FRESHNESS_FACTOR_STALE=0.1
ARTICLE_SCORING_FRESHNESS_FACTOR_ANCIENT=0.1

# WriterAgent LLM Configuration
# For DeepSeek:
# WRITER_AGENT_API_KEY=your_deepseek_api_key_here
# WRITER_AGENT_MODEL=deepseek-v4-flash
# WRITER_AGENT_BASE_URL=https://api.deepseek.com
WRITER_AGENT_API_KEY=
WRITER_AGENT_MODEL=deepseek-v4-flash
WRITER_AGENT_BASE_URL=https://api.deepseek.com
WRITER_AGENT_TEMPERATURE=0.7

# QualityAgent LLM Configuration
QUALITY_AGENT_API_KEY=
QUALITY_AGENT_MODEL=deepseek-v4-flash
QUALITY_AGENT_BASE_URL=https://api.deepseek.com

# SEOAgent LLM Configuration
SEO_AGENT_API_KEY=
SEO_AGENT_MODEL=deepseek-v4-flash
SEO_AGENT_BASE_URL=https://api.deepseek.com

# EditorAgent LLM Configuration
EDITOR_ENABLE_LLM=true
EDITOR_LLM_API_KEY=
EDITOR_LLM_MODEL=deepseek-v4-flash
EDITOR_LLM_BASE_URL=https://api.deepseek.com
EDITOR_DE_AI_API_KEY=
EDITOR_DE_AI_MODEL=deepseek-v4-flash
EDITOR_DE_AI_BASE_URL=https://api.deepseek.com

# MySQL Database Configuration
# LangGraph uses one MySQL database, not one standalone table. MYSQL_DATABASE
# must contain the crawler article tables and the LangGraph audit table. The
# default crawler tables are:
#   CRAWLER_MAIN_TABLE=crawler_news_main
#   CRAWLER_SHARD_PREFIX=crawler_news_
#   CRAWLER_SHARD_COUNT=5
#   pipeline_audit
# On an existing CMS server this may be an existing database such as zyxw; for
# isolated testing use a separate database such as multi_agent_cms. If the CMS
# table names differ, override the CRAWLER_* variables below.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change-me-mysql
MYSQL_ROOT_PASSWORD=change-me-mysql
MYSQL_DATABASE=multi_agent_cms
CRAWLER_MAIN_TABLE=crawler_news_main
CRAWLER_SHARD_PREFIX=crawler_news_
CRAWLER_SHARD_COUNT=5
# Leave this empty when the existing source table has no usage-status column.
CRAWLER_USAGE_STATUS_COLUMN=article_usage_status
PIPELINE_AUDIT_TABLE=pipeline_audit
# Optional secondary database used only by old/manual DB agent tools. The
# formal LangGraph article pipeline does not read from this database.
RESEARCH_MYSQL_DATABASE=research_article_data

# Docker pipeline service overrides.
# Inside Docker Compose, pipeline should connect to mysql service names.
# Keep these as-is unless you want the container to use an external database.
PIPELINE_MYSQL_HOST=mysql
PIPELINE_MYSQL_PORT=3306

# Pipeline gates. These are the source of truth for LangGraph routing and agent
# helper labels; change thresholds here instead of editing Python code.
AI_SCORE_THRESHOLD=75
QUALITY_PASS_THRESHOLD=70
REWRITE_QUALITY_THRESHOLD=70
QUALITY_READY_THRESHOLD=70
QUALITY_DIMENSION_WEAK_THRESHOLD=75
# Set false to stop QualityAgent from punishing rewritten drafts for AI smell.
# It will still score word count, fluency, structure, and attractiveness.
QUALITY_AI_FEEL_ENABLED=true

# Prompt/debug storage. Production keeps prompts/reasons in JSONL logs, not DB.
STORE_PROMPTS_IN_DB=false

# Old DB-based agent flows are disabled by default so they cannot be confused
# with the formal LangGraph pipeline. Enable only when intentionally debugging
# old tables.
ENABLE_LEGACY_DB_AGENT_TOOLS=false

FEED_MIN_CONTENT_CHARS=50
FEED_FETCH_MULTIPLIER=5

# Formal LangGraph runner.
# Default production command is still CMS dry-run:
#   python3 scripts/run_langgraph_batch.py --production
# Add --publish through LANGGRAPH_ARGS only when CMS_ENABLE_REAL_PUBLISH=true
# and CMS credentials are ready.
LANGGRAPH_BATCH_LIMIT=50
LANGGRAPH_PRODUCTION_SOURCE=latest
LANGGRAPH_LOOP=false
LANGGRAPH_LOOP_INTERVAL_SECONDS=60
LANGGRAPH_PERSIST_AUDIT=false
LANGGRAPH_MARK_USED=false
LANGGRAPH_SCORING_AI_CONCURRENCY=4
LANGGRAPH_FEED_EXISTING=true
LANGGRAPH_FEED_FROM_ID=0
LANGGRAPH_FEED_STATE_PATH=output/langgraph_feeder_state.json
LANGGRAPH_DEADLETTER_PATH=output/langgraph_deadletter.jsonl
LANGGRAPH_RUN_LOG=logs/langgraph_batch.log
LANGGRAPH_PID_FILE=output/langgraph_batch.pid
LANGGRAPH_LOG_LEVEL=INFO
LANGGRAPH_THIRD_PARTY_LOG_LEVEL=WARNING
# Feed-only idle backoff. When no articles are available, check again after
# 1h, then 2h, 4h, 8h, 12h, and 24h. Any productive batch resets to 1h.
LANGGRAPH_FEED_IDLE_BACKOFF_HOURS=1,2,4,8,12,24
LANGGRAPH_ARGS=

# Crawler Database Configuration
CRAWLER_DB_HOST=localhost
CRAWLER_DB_PORT=3306
CRAWLER_DB_USER=root
CRAWLER_DB_PASSWORD=change-me-mysql

# CMS Database Configuration
CMS_DB_HOST=localhost
CMS_DB_PORT=3306
CMS_DB_USER=root
CMS_DB_PASSWORD=change-me-mysql

# Prompt audit logging
# Prompt payloads are written to JSONL files, not MySQL.
PROMPT_AUDIT_ENABLED=true
PROMPT_AUDIT_LOG_DIR=logs/prompt_audit
PROMPT_AUDIT_TEXT_LIMIT=12000

# Huawei Cloud OBS Configuration
HUAWEI_OBS_ENDPOINT=https://obs.cn-north-4.myhuaweicloud.com
HUAWEI_OBS_BUCKET=your_obs_bucket
HUAWEI_OBS_ACCESS_KEY_ID=your_obs_access_key_id
HUAWEI_OBS_SECRET_ACCESS_KEY=your_obs_secret_access_key

# CMS API Configuration
CMS_API_URL=https://api-zyxw.cymba.cn
# BFF HMAC secret for /v2/article/publish and /v2/article/upload-image.
BFF_API_SECRET=your_bff_api_secret_here
CMS_API_KEY=
CMS_ENABLE_REAL_PUBLISH=false
CMS_REQUIRE_SCHEDULE_FOR_PUBLISH=false
# Optional strict publish verification. Keep false when BFF only returns
# articleid; set true only if BFF reliably returns the real public article URL.
CMS_REQUIRE_PUBLISH_URL=false
CMS_DEFAULT_AUTHOR=编辑部
CMS_DEFAULT_SOURCE=
CMS_SOURCE_TYPE=
CMS_ARTICLE_STATE=1
# BFF /v2/article/publish may return a real public URL in data.url,
# data.article_url, data.web_url, url, article_url, or web_url. If it only
# returns articleid, the pipeline still treats that id as publish success while
# leaving cms_article_url empty.
CMS_COLLEGE_ID=0
CMS_COLLEGE_NAME=
CMS_SPECIALTY_NAME=
# Scheduled CMS publishing. Disabled by default.
# Times define how many publish batches happen per day; per-slot defines how
# many articles can share each time. Default below means 5 batches/day, 10
# articles each batch, for up to 50 scheduled articles/day.
CMS_SCHEDULE_ENABLED=false
CMS_SCHEDULE_DISPATCH_ONLY_AT_SLOTS=true
CMS_SCHEDULE_SLOT_WINDOW_SECONDS=900
CMS_PENDING_PREPARE_TARGET=50
CMS_DAILY_PUBLISH_TARGET=50
CMS_SCHEDULE_TIMES=09:00,11:00,13:00,15:00,17:00
CMS_SCHEDULE_PER_SLOT=10
CMS_SCHEDULE_TIMEZONE_OFFSET=+08:00
CMS_SCHEDULE_STATE_PATH=output/cms_publish_schedule_state.json
# Pending preparation normally follows LANGGRAPH_BATCH_LIMIT. Keep the two
# budget knobs at 0 for the original always-refill behavior; set them only for
# emergency cost control.
CMS_PREPARE_BATCH_LIMIT=50
CMS_PREPARE_MAX_SCORING_PER_DAY=0
CMS_PREPARE_MAX_BATCHES_PER_DAY=0
CMS_PREPARE_STATE_PATH=output/cms_prepare_state.json

# Image generation
IMAGE_PROVIDER=coze
COZE_JWT_TOKEN=
COZE_IMAGE_MODEL=
# Before calling the image provider, rewritten articles can use DeepSeek to turn
# title/body context into a richer cover prompt. This costs text tokens only and
# is tiny compared with the per-image provider charge.
IMAGE_PROMPT_LLM_ENABLED=true
IMAGE_PROMPT_API_KEY=
IMAGE_PROMPT_BASE_URL=https://api.deepseek.com
IMAGE_PROMPT_MODEL=deepseek-v4-flash
IMAGE_PROMPT_CONTEXT_CHARS=1200
IMAGE_PROMPT_MAX_TOKENS=220
IMAGE_PROMPT_TEMPERATURE=0.3
# Rewritten articles prefer a generated cover. If the image provider fails,
# fall back to the crawler/source cover instead of blocking the whole article.
IMAGE_FALLBACK_TO_SOURCE_ON_GENERATION_FAILURE=true

# OpenAI / ChatGPT image generation
IMAGE_OPENAI_API_KEY=
IMAGE_OPENAI_BASE_URL=https://api.openai.com/v1
IMAGE_OPENAI_MODEL=gpt-image-1
IMAGE_OPENAI_SIZE=1024x1024
IMAGE_OPENAI_QUALITY=standard

# Seedance / Seedream image generation.
# Set IMAGE_PROVIDER=seedance and provide an OpenAI-compatible image endpoint.
SEEDANCE_API_KEY=
SEEDANCE_BASE_URL=
SEEDANCE_MODEL=seedream-3-0-t2i-250415
SEEDANCE_SIZE=1024x1024
SEEDANCE_QUALITY=standard

# Tools API Keys
SERPAPI_API_KEY=your_serpapi_key_here
AHREFS_API_KEY=your_ahrefs_api_key_here
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=multi-agent-cms

# DataAgent / Analytics
GOOGLE_APPLICATION_CREDENTIALS=path_to_service_account.json
GA_PROPERTY_ID=your_ga4_property_id
GSC_SITE_URL=https://example.com/
BAIDU_SITE_ID=your_baidu_site_id
BAIDU_TOKEN=your_baidu_token

# Crawler workflow
CRAWLER_ENABLE_LLM_DECISION=false
RESEARCH_AGENT_MODE=live
